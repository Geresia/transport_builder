node_modules/
.gstack/
.env
.env.local
*.log
dist/
build/

# generated by scripts/export-subway-builder-*.mjs; regenerate from packs/tokyo/, don't hand-edit
transitline/subway-builder-export/*.json
transitline/subway-builder-export/*.geojson
# game-ready city folder (295 MB buildings .bin etc.), tile work files, and the tiling tool (93 MB jar)
transitline/subway-builder-export/city-TYOTL/
transitline/subway-builder-export/city-work/
transitline/data-raw/planetiler.jar
# Generated HTML maps — 기본은 제외(빌드 산출물이고 덩치가 크다)
transitline/docs/*.html
# 단, 배포판 지도는 커밋한다. 클론해서 바로 열 수 있어야 하고,
# 들어간 데이터가 전부 공개 라이선스라 저장소가 공개로 바뀌어도 안전하다.
!transitline/docs/korea-density-game.html
# 상세 베이스맵도 커밋한다. 두 세션이 같은 파일을 고쳐야 해서 이게 유일한 원본이다.
!transitline/docs/korea-basemap.html
# korea-density.html(연구판)은 SGIS 집계구가 들어있어 제외 상태를 유지한다.

# R2 업로드 묶음 — build-r2-bundle.mjs 가 만드는 파생물. 원본은 docs/ 와 스크래치패드.
transitline/r2/
# Submodules
bot/
depot/
monorepo/
registry/
template-mod/

# 승인 조건부 데이터 — 비영리 연구·교육 한정, 국외반출/재배포 금지.
# SGIS 집계구, 도로명주소 건물DB·좌표·도형. 절대 커밋 금지.
sgis/
juso/
oa_*.json
*.shp
*.dbf
*.shx

# validate-pack fingerprint cache
transitline/.cache/

# raw e-Stat downloads and unpacked sheets (regenerate per packs/tokyo/README.md); small derived od-*.json are kept
transitline/data-raw/od2020/*.xlsx
transitline/data-raw/od2020/x*/
transitline/data-raw/od2020/mismatch.json
transitline/data-raw/demand.before-census.json

# DEM / slope raw + derived data, too large to commit (see transitline/data-raw/terrain/README.md)
transitline/data-raw/terrain/

# raw Overpass OSM route-relation dumps, ~38MB, see transitline/data-raw/README.md
transitline/data-raw/rail-network/

# raw e-Stat CSVs for employed.json (regenerate per packs/tokyo/README.md)
transitline/data-raw/emp2020/*.csv

# raw downloads, see transitline/data-raw/README.md
transitline/data-raw/tama/
transitline/data-raw/mlit/
transitline/data-raw/plateau/
transitline/data-raw/tourism/
transitline/data-raw/hotels/

# Claude Code local settings
.claude/

# Ruflo runtime state and generated local report intermediates
/.claude-flow/
transitline/tmp/

# mod build artifacts
transitline/mods/*/node_modules/
transitline/mods/*/dist/
