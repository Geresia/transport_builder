{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transitline.dev/schemas/citypack-demand.schema.json",
  "title": "CityPack Demand",
  "type": "object",
  "required": [
    "formatVersion",
    "model",
    "points"
  ],
  "additionalProperties": true,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "model": {
      "enum": [
        "matrix",
        "gravity"
      ],
      "description": "'matrix' = measured origin-destination trips. 'gravity' = trips inferred from residents/jobs."
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "location"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "residents": {
            "type": "number",
            "minimum": 0
          },
          "jobs": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "description": "Required when model is 'matrix'; ignored otherwise.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "trips"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "trips": {
            "type": "number",
            "minimum": 0
          },
          "period": {
            "type": "string",
            "examples": [
              "am_peak",
              "pm_peak",
              "offpeak",
              "daily"
            ],
            "description": "References calendar.periods[].id when a calendar is present."
          },
          "dayType": {
            "type": "string",
            "description": "References calendar.dayTypes[].id. Omitted flows are daily totals."
          }
        }
      }
    },
    "attractors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "location",
          "capacity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "Free string. Unknown kinds fall back to a generic marker."
          },
          "location": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "capacity": {
            "type": "number",
            "minimum": 0,
            "description": "Daily people generated or absorbed."
          },
          "maxDistance": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Metres beyond which this attractor draws nobody. null = unbounded."
          },
          "residentialSplit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Share of capacity living on site rather than travelling in."
          }
        }
      }
    },
    "calendar": {
      "type": "object",
      "required": [
        "dayTypes",
        "periods",
        "factors"
      ],
      "additionalProperties": false,
      "description": "Optional. Absent means a single undifferentiated average day.",
      "properties": {
        "dayTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "description": "Days per week of this type."
              }
            }
          }
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "description": "Must tile the service day with no gaps or overlaps.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "startMinute",
              "endMinute"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "startMinute": {
                "type": "number",
                "minimum": 0,
                "description": "Minutes from service-day start."
              },
              "endMinute": {
                "type": "number",
                "minimum": 0,
                "description": "May exceed 1440 for after-midnight service."
              }
            }
          }
        },
        "factors": {
          "type": "object",
          "description": "dayType id -> period id -> multiplier. Must be complete.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model": {
            "const": "matrix"
          }
        },
        "required": [
          "model"
        ]
      },
      "then": {
        "required": [
          "flows"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "model": {
            "const": "gravity"
          }
        },
        "required": [
          "model"
        ]
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "residents"
                  ]
                },
                {
                  "required": [
                    "jobs"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
