{
  "name": "transitline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test engine/test/*.test.mjs",
    "test:engine": "node --test engine/test/*.test.mjs",
    "validate": "node scripts/validate-all.mjs",
    "plan-examples": "node --max-old-space-size=4096 scripts/build-plan-examples.mjs",
    "depot-examples": "node --max-old-space-size=6144 scripts/build-depot-examples.mjs",
    "station-examples": "node --max-old-space-size=6144 scripts/build-station-examples.mjs",
    "construction-examples": "node --max-old-space-size=6144 scripts/build-construction-examples.mjs",
    "construction-impact-examples": "node --max-old-space-size=6144 scripts/build-construction-impact-examples.mjs",
    "construction-workfront-examples": "node --max-old-space-size=6144 scripts/build-construction-workfront-examples.mjs",
    "through-route-examples": "node scripts/build-through-route-examples.mjs",
    "external-rail-technical-examples": "node scripts/build-external-rail-technical-examples.mjs",
    "through-handover-examples": "node scripts/build-through-handover-examples.mjs",
    "rail-capacity-examples": "node scripts/build-rail-capacity-examples.mjs",
    "regen": "node packs/example-radial/generate.mjs && node packs/example-corridor/generate.mjs"
  }
}
