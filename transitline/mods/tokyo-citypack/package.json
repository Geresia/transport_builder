{
  "name": "tokyo-citypack",
  "version": "0.1.0",
  "description": "Registers Greater Tokyo as a playable Subway Builder city, backed by transitline's real census/survey data export",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k -n build,game -c blue,green \"vite build --watch\" \"tsx scripts/run.ts\"",
    "dev:link": "tsx scripts/link.ts",
    "dev:unlink": "tsx scripts/link.ts --unlink",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["subway-builder", "mod"],
  "author": "transitline",
  "license": "CC0-1.0",
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "concurrently": "^9.2.1",
    "maplibre-gl": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-static-copy": "^3.0.0"
  }
}
